# No environment variables are required for an initial/pre-launch deployment.
# Copy this file to .env.local for local integration work, or add the relevant
# values to the deployment host when each integration is ready.

# Account deletion (Supabase public browser/API credentials only).
# Never use a service-role or sb_secret key here.
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=

# Required for live form origin checks. Use the final HTTPS origin with no
# trailing slash. It must match siteUrl in site.config.json for public release.
SITE_ORIGIN=

# Support form delivery (Resend).
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
SUPPORT_TO_EMAIL=

# Cloudflare Turnstile secret. The matching public site key belongs in
# site.config.json as turnstileSiteKey.
TURNSTILE_SECRET_KEY=
