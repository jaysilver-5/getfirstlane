{
  "name": "firstlane-landing", "version": "1.0.0", "private": true, "type": "module",
  "description": "FirstLane's responsive marketing, support and account-control website.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/server.mjs",
    "build:local": "node scripts/build.mjs",
    "build": "node --env-file-if-exists=.env.local scripts/build.mjs",
    "build:release": "node --env-file-if-exists=.env.local scripts/build.mjs --production",
    "release:check": "node --env-file-if-exists=.env.local scripts/release-check.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
